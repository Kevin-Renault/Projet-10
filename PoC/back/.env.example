# Example environment file for the PoC backend
# COPY this to .env and edit secrets locally (do NOT commit .env)

# Database (used by the postgres Docker image when starting the container)
POSTGRES_DB=ycyw_poc
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_locally

# Note: the application uses `DB_*` variables. In Quick-start we map
# `POSTGRES_*` → `DB_*` in the shell so you only need to set the
# Postgres variables below (Docker will also read them).

# JWT configuration
# Provide a strong secret (>=32 chars) for local development
JWT_SECRET=replace_with_a_32+_char_secret
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# Optional cookie settings
#JWT_COOKIE_SECURE=false
#JWT_COOKIE_SAMESITE=Lax
